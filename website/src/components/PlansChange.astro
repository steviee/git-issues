---
---

<section id="plans" class="py-32 px-6 md:px-8 lg:px-12 border-t border-[#262626]">
  <div class="max-w-[1200px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Visual -->
      <div class="order-2 lg:order-1">
        <div class="rounded-xl bg-[#0c0c0c] border border-[#1f1f1f] p-5 font-mono text-sm shadow-2xl"
          style="box-shadow: 0 0 60px rgba(34, 197, 94, 0.05);"
        >
          <div class="flex items-center gap-2 text-[#525252] mb-3 pb-3 border-b border-[#1f1f1f]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
              <path d="M14 2v4a2 2 0 0 0 2 2h4" />
            </svg>
            <span>.issues/0001-fix-login-bug.md</span>
          </div>
          <div class="text-[#525252] mb-2">---</div>
          <div class="space-y-1">
            <div><span class="text-[#a3a3a3]">id:</span> <span class="text-[#22c55e]">1</span></div>
            <div><span class="text-[#a3a3a3]">title:</span> <span class="text-[#f5f5f5]">"Fix login bug"</span></div>
            <div class="flex items-center gap-1">
              <span class="text-[#a3a3a3]">priority:</span>
              <span class="text-[#f5f5f5]">medium</span>
              <span class="inline-block w-2 h-4 bg-[#22c55e] ml-1 animate-pulse" />
            </div>
            <div><span class="text-[#a3a3a3]">labels:</span> <span class="text-[#f5f5f5]">[bug, auth]</span></div>
          </div>
          <div class="text-[#525252] mt-2 mb-2">---</div>
          <div class="text-[#a3a3a3] leading-relaxed">
            Login schlägt bei leeren Passwörtern fehl.
          </div>
          <div class="mt-4 pt-4 border-t border-[#1f1f1f] text-[#525252] text-xs">
            <span class="text-[#22c55e]">~</span> vim .issues/0001-fix-login-bug.md — 3s ago
          </div>
        </div>
      </div>

      <!-- Right: Text -->
      <div class="order-1 lg:order-2 flex flex-col gap-6">
        <div class="inline-flex">
          <span class="font-mono text-xs font-medium uppercase tracking-[0.05em] text-[#525252] bg-[#141414] border border-[#262626] rounded-full px-3 py-1">
            Plain Text
          </span>
        </div>

        <h2 class="text-4xl md:text-[44px] font-bold leading-[1.1] tracking-[-0.02em]">
          Plans change.
          <br />
          <span class="text-[#22c55e]">Your issues too.</span>
        </h2>

        <p class="text-lg text-[#a3a3a3] leading-relaxed">
          No rigid forms. No API rate limits. No "can't edit because the server is down."
          Issues are Markdown. Edit them in Vim, VS Code, or directly in the GitHub UI.
        </p>

        <div class="flex flex-col gap-4 mt-2">
          <div class="flex items-start gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <div>
              <h4 class="font-semibold text-[#f5f5f5]">Plain text</h4>
              <p class="text-sm text-[#a3a3a3]">YAML + Markdown. Every editor, every agent, every human can read it.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <div>
              <h4 class="font-semibold text-[#f5f5f5]">No lock-in</h4>
              <p class="text-sm text-[#a3a3a3]">Want to leave? Delete <code>issues</code>, keep the <code>.md</code> files. Done.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <div>
              <h4 class="font-semibold text-[#f5f5f5]">Offline first</h4>
              <p class="text-sm text-[#a3a3a3]">No network needed. Edit issues on a plane, in a tunnel, anywhere.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
