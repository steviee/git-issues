---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import TerminalDemo from '../components/TerminalDemo.tsx';
import NeverOutOfSync from '../components/NeverOutOfSync.astro';
import PlansChange from '../components/PlansChange.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import AgentWorkflow from '../components/AgentWorkflow.astro';
import CommandPreview from '../components/CommandPreview.tsx';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main>
    <HeroSection />

    <!-- Terminal Demo Section -->
    <section class="py-16 px-6 md:px-8 lg:px-12">
      <div class="max-w-[1200px] mx-auto">
        <TerminalDemo client:load />
      </div>
    </section>

    <NeverOutOfSync />
    <PlansChange />
    <FeatureGrid />
    <AgentWorkflow />
    <CommandPreview client:load />
  </main>
  <Footer />
</Layout>
